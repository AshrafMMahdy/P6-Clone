+    drop(rf);
+    let diagnostics = serde_wasm_bindgen::to_value(&result.diagnostics).map_err(err_str)?;
+    write_step_to(&result.model, &StepOptions::default(), Box::new(|chunk: &str| rvt_ifc_sink(chunk)));
