+/// P6 Clone: [`write_step_with_options`], the text handed to `sink` a piece at a time (about 8 MiB each, whole lines)
+/// instead of returned as one string, so a big model's STEP is never held whole. The same text, piece by piece.
+pub fn write_step_to(model: &IfcModel, options: &StepOptions, sink: Box<dyn FnMut(&str)>) {
+    let now = options.timestamp.unwrap_or_else(unix_seconds);
+    let mut w = StepWriter::new(now);
+    w.sink = Some(sink);
+    w.emit_header(model);
+    w.emit_data(model);
+    let mut sink = w.sink.take().expect("set above");
+    sink(&w.finish());
+}
