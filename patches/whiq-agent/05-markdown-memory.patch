+/**
+ * The Memory as Markdown files (WHIQ_MEMORY_DIR): the file format and the names, apart from the store that keeps them.
+ *
+ *   <dir>/<scope>/<Kind folder>/<title>.md          scope = "General", or the project's name
+ *   <dir>/<scope>/_Retired/<Kind folder>/…          retired entries (kept, out of the live folders)
+ *   <dir>/<scope>/_Superseded/<Kind folder>/…       entries a newer one replaced
+ *
+ * A file is a front matter block (every field of the MemoryItem, so the entry round-trips whole) and the memory's text as
+ * the Markdown body. The front matter is the small YAML subset written here and read back below (scalars, one-line lists, a
+ * block list of mappings for the history): hand-edited files in the usual YAML shapes read too.
+ */
+import type { MemoryChange, MemoryItem } from '../types';
+
+export const GENERAL = 'General';
+const KIND_FOLDER: Record<string, string> = { fact: 'Facts', preference: 'Preferences', party: 'People and parties', decision: 'Decisions', other: 'Other', intro: 'Project introduction' };
+export const kindFolder = (k: MemoryItem['kind']): string => KIND_FOLDER[k ?? 'other'] ?? 'Other';
+/** A kind written by hand: "fact", "Facts", "people and parties" … */
+export function kindOfName(s: string): MemoryItem['kind'] | undefined {
+  const t = s.trim().toLowerCase();
+  return (Object.keys(KIND_FOLDER) as Array<NonNullable<MemoryItem['kind']>>).find((k) => k === t || KIND_FOLDER[k].toLowerCase() === t || `${k}s` === t);
+}
+const ACTIONS = new Set<MemoryChange['action']>(['written', 'edited', 'superseded', 'retired', 'restored']);
+
+// ── names ──────────────────────────────────────────────────────────────────────────────────────────────────────────
+const RESERVED = /^(con|prn|aux|nul|com[0-9¹²³]|lpt[0-9¹²³])$/i;
+/** A name any file system takes (Windows included): no \ / : * ? " < > | or control characters, no reserved device name, no
+ *  trailing dot or space, at most `max` characters, never empty. */
+export function safeName(raw: string, max = 60, fallback = 'memory'): string {
+  let s = raw.normalize('NFC').replace(/[\\/:*?"<>|\u0000-\u001f\u007f]+/g, ' ').replace(/\s+/g, ' ').trim();
+  if (s.length > max) { const cut = s.slice(0, max); s = cut.slice(0, Math.max(cut.lastIndexOf(' '), Math.floor(max / 2))).replace(/[\ud800-\udbff]$/, ''); }   // a word boundary when there is one
+  s = s.replace(/^[.\s]+|[.\s]+$/g, '');
+  if (!s) return fallback;
+  if (RESERVED.test(s.split('.')[0].trimEnd())) s = `_${s}`;   // CON, con.txt … are devices on Windows
+  return s;
+}
+/** The file name for an entry: its first words. */
+export const titleOf = (text: string): string => safeName(text.replace(/[#>*_`~\[\]]+/g, ' ').split(/\r?\n/).find((l) => l.trim()) ?? '', 60);
+
+// ── writing ────────────────────────────────────────────────────────────────────────────────────────────────────────
+const bare = (s: string): boolean => /^[A-Za-z0-9_][A-Za-z0-9_.:+-]*$/.test(s) && !/^(true|false|null|yes|no|on|off|~)$/i.test(s) && !/^[0-9.+-]+$/.test(s);
+const sc = (s: string): string => (bare(s) ? s : JSON.stringify(s));
+function line(out: string[], key: string, v: string | undefined, indent = ''): void { if (v !== undefined) out.push(`${indent}${key}: ${sc(v)}`); }
+
+export function renderMemoryFile(m: MemoryItem, projectName?: string): string {
+  const o: string[] = ['---'];
+  line(o, 'id', m.id);
+  line(o, 'kind', m.kind);
+  if (m.tags) o.push(`tags: [${m.tags.map((t) => sc(t)).join(', ')}]`);
+  line(o, 'author', m.authorId); line(o, 'module', m.module); line(o, 'org', m.orgId);
+  line(o, 'project', m.projectId); line(o, 'projectName', m.projectId ? projectName : undefined);
+  line(o, 'sourceChat', m.sourceChatId);
+  line(o, 'created', m.createdAt); line(o, 'updated', m.updatedAt); line(o, 'expiresAt', m.expiresAt);
+  line(o, 'supersededAt', m.supersededAt); line(o, 'supersededBy', m.supersededBy);
+  line(o, 'retiredAt', m.retiredAt); line(o, 'retiredReason', m.retiredReason);
+  if (m.history) {
+    if (!m.history.length) o.push('history: []');
+    else {
+      o.push('history:');
+      for (const c of m.history) {
+        o.push(`  - at: ${sc(c.at)}`); line(o, 'by', c.by, '    '); line(o, 'action', c.action, '    ');
+        line(o, 'text', c.text, '    '); line(o, 'note', c.note, '    ');
+      }
+    }
+  }
+  o.push('---', '', m.text, '');
+  return o.join('\n');
