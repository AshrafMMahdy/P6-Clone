+  for (let i = 1; i < end; i++) {
+    const l = lines[i];
+    if (!l.trim() || l.trim().startsWith('#')) continue;
+    if (/^\s/.test(l) || l.startsWith('- ')) {
+      const t = l.trim();
+      if (openKey === 'history') {
+        const item = t.startsWith('- ') ? (cur = {}, hist.push(cur), t.slice(2).trim()) : t;
+        const kv = KV.exec(item);
+        if (!kv || !cur) return { ok: false, why: `line ${i + 1} of its front matter is not a history entry ("${t.slice(0, 40)}")` };
+        cur[kv[1]] = scalar(kv[2] ?? '');
+      } else if (openKey && t.startsWith('- ')) ((f[openKey] ??= []) as string[]).push(scalar(t.slice(2)));
+      else return { ok: false, why: `line ${i + 1} of its front matter is out of place ("${t.slice(0, 40)}")` };
+      continue;
+    }
+    const kv = KV.exec(l.trimEnd());
+    if (!kv) return { ok: false, why: `line ${i + 1} of its front matter is not "key: value" ("${l.slice(0, 40)}")` };
+    const [, key, v = ''] = kv;
+    openKey = key;
+    if (key === 'history') { histSeen = true; if (v.trim() && v.trim() !== '[]') return { ok: false, why: 'its history is not a list of entries' }; }
+    else if (v.trim() === '') f[key] = [];   // a block list follows, or an empty value
+    else f[key] = v.trim().startsWith('[') ? flowList(v) : (key === 'tags' && !v.trim().startsWith('"') ? v.split(',').map((x) => scalar(x)).filter(Boolean) : scalar(v));
+  }
+  const str = (k: string): string | undefined => { const v = f[k]; const s = Array.isArray(v) ? (v.length ? v.join(', ') : undefined) : v; return s === '' || s === 'null' || s === '~' ? undefined : s; };
+  const text = lines.slice(end + 1).join('\n').trim();
+  if (text.length < 4) return { ok: false, why: 'it holds no text under its front matter' };
+  const kindRaw = str('kind'); const kind = kindRaw ? kindOfName(kindRaw) : (str('id') ? undefined : folderKind);   // the folder says the kind of a file that is not an entry yet
+  if (kindRaw && !kind) return { ok: false, why: `its kind "${kindRaw}" is not one of ${Object.values(KIND_FOLDER).join(', ')}` };
+  const format = str('format');
+  if (format && format !== '1') return { ok: false, why: `its format ${format} is another build's` };
+  const history: MemoryChange[] = [];
+  for (const h of hist) {
+    if (!h.at || !h.by || !ACTIONS.has(h.action as MemoryChange['action'])) return { ok: false, why: `a history entry is incomplete or has an unknown action ("${h.action ?? ''}")` };
+    history.push({ at: h.at, by: h.by, action: h.action as MemoryChange['action'], ...(h.text !== undefined && h.text !== '' ? { text: h.text } : {}), ...(h.note !== undefined && h.note !== '' ? { note: h.note } : {}) });
+  }
+  const tags = f.tags === undefined ? undefined : (Array.isArray(f.tags) ? f.tags : [f.tags]);
+  const opt = <K extends string>(k: K, v: string | undefined) => (v === undefined ? {} : { [k]: v });
+  const item: MemoryItem = {
+    id: str('id') ?? '', text,
+    ...opt('kind', kind), ...opt('orgId', str('org')), ...opt('authorId', str('author')), ...opt('module', str('module')), ...opt('projectId', str('project')),
+    ...opt('sourceChatId', str('sourceChat')), createdAt: str('created') ?? mtime,
+    ...(tags ? { tags } : {}), ...opt('updatedAt', str('updated')), ...opt('supersededAt', str('supersededAt')), ...opt('supersededBy', str('supersededBy')),
+    ...opt('retiredAt', str('retiredAt')), ...opt('retiredReason', str('retiredReason')), ...opt('expiresAt', str('expiresAt')),
+    ...(histSeen ? { history } : {}),
+  };
+  return { ok: true, noId: !item.id, item, projectName: str('projectName') };
+}
