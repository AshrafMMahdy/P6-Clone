+/** The text of one file → the entry, or why it cannot be read as one. `mtime` stands in for a missing created stamp. */
+export function parseMemoryFile(raw: string, mtime: string, folderKind?: MemoryItem['kind']): Parsed {
+  const src = raw.charCodeAt(0) === 0xfeff ? raw.slice(1) : raw;
+  const lines = src.split(/\r?\n/);
+  if (lines[0]?.trimEnd() !== '---') {
