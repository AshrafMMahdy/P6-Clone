+  return t.replace(/\s+#.*$/, '');   // a trailing comment
+}
+function flowList(v: string): string[] {
+  const inner = v.trim().replace(/^\[/, '').replace(/\]$/, '');
+  const parts: string[] = []; let cur = '', q = '';
+  for (const ch of inner) {
+    if (q) { cur += ch; if (ch === q && !cur.endsWith(`\\${q}`)) q = ''; }
