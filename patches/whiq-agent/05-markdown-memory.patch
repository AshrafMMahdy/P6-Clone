+
+// ── reading ────────────────────────────────────────────────────────────────────────────────────────────────────────
+export type Parsed = { ok: true; item: MemoryItem; projectName?: string; noId: boolean } | { ok: false; why: string };
+
+function scalar(v: string): string {
+  const t = v.trim();
+  if (t.startsWith('"')) { try { const x = JSON.parse(t); if (typeof x === 'string') return x; } catch { /* fall through: a hand-written quote */ } return t.replace(/^"|"$/g, ''); }
