{
  "name": "p6-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Primavera P6 Professional clone for testing XER output",
  "main": "dist/main.cjs",
  "bin": {
    "p6clone": "cli/p6clone.ts",
    "p6clone-mcp": "mcp/server.ts"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "package": "node scripts/package.mjs",
    "e2e": "node scripts/build.mjs && node --test \"tests/e2e/*.test.ts\"",
    "build:cli": "node scripts/build-cli.mjs",
    "mcp": "node mcp/server.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  }
}
