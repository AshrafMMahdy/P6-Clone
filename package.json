{
  "name": "p6-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Primavera P6 Professional clone for testing XER output",
  "main": "dist/main.cjs",
  "bin": {
    "p6clone": "cli/p6clone.ts"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "e2e": "node scripts/build.mjs && node --test \"tests/e2e/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
