<Project Sdk="Microsoft.NET.Sdk">
  <!-- OPTIONAL (M7): runs Navisworks without its window (Automation API) to turn a package into a linked NWD. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <NavisworksDir Condition="'$(NavisworksDir)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2025</NavisworksDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Automation"><HintPath>$(NavisworksDir)\Autodesk.Navisworks.Automation.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
